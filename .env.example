# Optional. docker-compose.yml has working defaults for every one of these, so the stack runs
# with no .env at all — copy this to .env only when you need to change something (a port that is
# already taken locally is the usual reason).

# Host ports. Change these if 3306 / 9200 / 3000 are in use on your machine.
API_PORT=3000
MYSQL_PORT=3306
ES_PORT=9200

# MySQL credentials. Demo values — see the README's limitations on secrets.
MYSQL_ROOT_PASSWORD=rootpw
MYSQL_DATABASE=ecommerce
MYSQL_USER=shop
MYSQL_PASSWORD=shoppw
