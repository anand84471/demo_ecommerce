# Copy this file to .env and adjust any values you need to override.
# Every variable has a sensible default, so the stack runs with no .env at all.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ecommerce
MYSQL_USER=shop
MYSQL_PASSWORD=shoppw
MYSQL_POOL_SIZE=10

# ── Elasticsearch ─────────────────────────────────────────────────────────────
ELASTICSEARCH_NODE=http://127.0.0.1:9200
# The indexes the API reads and the sync rebuilds. Change them to point a deployment at a
# reindexed copy, or to share one cluster between stacks.
ES_PRODUCTS_INDEX=products
ES_CATEGORIES_INDEX=categories

# ── Catalogue sync ────────────────────────────────────────────────────────────
# One job, three triggers: `npm run seed`, the cron below, and POST /sync.
DUMMYJSON_URL=https://dummyjson.com
# Set to true to re-fetch and rewrite even when both stores already hold data.
SEED_FORCE=false
SEED_BATCH_SIZE=500

# The scheduled run. Off by default: a process that calls a third-party feed on a timer should
# be asked for. docker-compose turns it on.
SYNC_CRON_ENABLED=false
# Standard five-field cron. Validated at boot — a typo here fails the start.
SYNC_CRON_SCHEDULE=0 3 * * *
SYNC_CRON_TIMEZONE=UTC
# When set, POST /sync requires this value in an X-Sync-Token header. Empty leaves the endpoint
# open, which is fine on a laptop and is NOT fine on anything with a public address: a sync drops
# and rebuilds both Elasticsearch indexes.
SYNC_TRIGGER_TOKEN=

# ── Paging ────────────────────────────────────────────────────────────────────
DEFAULT_LIMIT=20
MAX_LIMIT=100
# Hard ceiling on offset+limit. ES rejects windows past 10k.
MAX_WINDOW=10000
